generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

model Gig {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  sellerId         String            @db.ObjectId
  username         String
  profilePicture   String
  email            String
  title            String
  description      String
  basicTitle       String
  basicDescription String
  categories       String
  subCategories    String[]
  tags             String[]
  active           Boolean           @default(true)
  expectedDelivery String            @default("")
  ratingsCount     Int               @default(0)
  ratingSum        Int               @default(0)
  ratingCategories RatingCategories?
  price            Float             @default(0)
  sortId           Int?
  coverImage       String
  createdAt        DateTime          @default(now()) @map("createdAt")
}

model RatingCategories {
  id       String        @id @default(auto()) @map("_id") @db.ObjectId
  gig      Gig           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId String        @unique @db.ObjectId
  five     RatingDetails @relation("FiveRating", fields: [fiveRatingId], references: [id], onDelete: Cascade)
  fiveRatingId   String        @unique @db.ObjectId
  four     RatingDetails @relation("FourRating", fields: [fourRatingId], references: [id], onDelete: Cascade)
  fourRatingId   String        @unique @db.ObjectId
  three    RatingDetails @relation("ThreeRating", fields: [threeRatingId], references: [id], onDelete: Cascade)
  threeRatingId  String        @unique @db.ObjectId
  two      RatingDetails @relation("TwoRating", fields: [twoRatingId], references: [id], onDelete: Cascade)
  twoRatingId    String        @unique @db.ObjectId
  one      RatingDetails @relation("OneRating", fields: [oneRatingId], references: [id], onDelete: Cascade)
  oneRatingId    String        @unique @db.ObjectId

  @@map("rating_categories")
}

model RatingDetails {
  id    String            @id @default(auto()) @map("_id") @db.ObjectId
  value Int               @default(0)
  count Int               @default(0)
  five  RatingCategories? @relation("FiveRating")
  four  RatingCategories? @relation("FourRating")
  three RatingCategories? @relation("ThreeRating")
  two   RatingCategories? @relation("TwoRating")
  one   RatingCategories? @relation("OneRating")

  @@map("rating_details")
}
