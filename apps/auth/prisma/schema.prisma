model AuthSession {
  id           Int      @id @default(autoincrement())
  refreshToken String
  accessToken  String
  authId       Int
  auth         Auth?    @relation(fields: [authId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([authId])
}

model VerifiedEmail {
  id                     Int     @id @default(autoincrement())
  emailVerificationToken String?
  authId                 Int?
  auth                   Auth?   @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@unique([authId])
  @@index([authId])
}

model AuthOTP {
  id      Int      @id @default(autoincrement())
  otp     String?
  expires DateTime
  authId  Int?
  auth    Auth?    @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@unique([authId])
  @@index([authId])
}

