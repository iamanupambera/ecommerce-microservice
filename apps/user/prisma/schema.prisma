generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

model Seller {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  fullName       String
  username       String          @unique
  email          String          @unique
  profilePicture String
  description    String
  bio            String          @default("")
  country        String
  languages      Language[]
  skills         String[]
  ratingsCount   Int             @default(0)
  ratingSum      Int             @default(0)
  ratingCategory RatingCategory?
  responseTime   Int             @default(0)
  recentDelivery DateTime?
  experience     Experience[]
  education      Education[]
  socialLinks    String[]
  certificates   Certificate[]
  ongoingJobs    Int             @default(0)
  completedJobs  Int             @default(0)
  cancelledJobs  Int             @default(0)
  totalEarnings  Float           @default(0)
  totalGigs      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([username, email])
  @@map("sellers")
}

model Language {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId String @db.ObjectId
  language String
  level    String

  @@index([sellerId])
  @@map("languages")
}

model Experience {
  id                   String  @id @default(auto()) @map("_id") @db.ObjectId
  seller               Seller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId             String  @db.ObjectId
  company              String  @default("")
  title                String  @default("")
  startDate            String  @default("")
  endDate              String  @default("")
  description          String  @default("")
  currentlyWorkingHere Boolean @default(false)

  @@index([sellerId])
  @@map("experiences")
}

model Education {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  seller     Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId   String @db.ObjectId
  country    String @default("")
  university String @default("")
  title      String @default("")
  major      String @default("")
  year       String @default("")

  @@index([sellerId])
  @@map("educations")
}

model Certificate {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId String @db.ObjectId
  name     String
  from     String
  year     Int

  @@index([sellerId])
  @@map("certificates")
}

model RatingCategory {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  seller        Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId      String        @unique @db.ObjectId
  five          RatingDetails @relation("FiveRating", fields: [fiveRatingId], references: [id], onDelete: Cascade)
  fiveRatingId  String        @unique @db.ObjectId
  four          RatingDetails @relation("FourRating", fields: [fourRatingId], references: [id], onDelete: Cascade)
  fourRatingId  String        @unique @db.ObjectId
  three         RatingDetails @relation("ThreeRating", fields: [threeRatingId], references: [id], onDelete: Cascade)
  threeRatingId String        @unique @db.ObjectId
  two           RatingDetails @relation("TwoRating", fields: [twoRatingId], references: [id], onDelete: Cascade)
  twoRatingId   String        @unique @db.ObjectId
  one           RatingDetails @relation("OneRating", fields: [oneRatingId], references: [id], onDelete: Cascade)
  oneRatingId   String        @unique @db.ObjectId

  @@map("rating_categories")
}

model RatingDetails {
  id    String          @id @default(auto()) @map("_id") @db.ObjectId
  value Int             @default(0)
  count Int             @default(0)
  five  RatingCategory? @relation("FiveRating")
  four  RatingCategory? @relation("FourRating")
  three RatingCategory? @relation("ThreeRating")
  two   RatingCategory? @relation("TwoRating")
  one   RatingCategory? @relation("OneRating")

  @@map("rating_details")
}

model Buyer {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  username       String   @unique
  email          String   @unique
  profilePicture String
  country        String
  isSeller       Boolean  @default(false)
  purchasedGigs  String[] @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([username, email])
  @@map("buyers")
}
